# Copy this file to .env in the CareCatalyzer project root.
# Add your Google AI Studio key, then restart npm run dev.
# Keep the key server-side: do not prefix it with VITE_.
GEMINI_API_KEY=

# Optional model overrides (defaults shown).
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_CHAT_FALLBACK_MODELS=
GEMINI_LIVE_VOICE=

# Optional server TTS for the turn-based call (Plan B). Without it: Gemini TTS, then browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
